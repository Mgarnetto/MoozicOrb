@{
    Layout = "";
}
<!DOCTYPE html>
<html>
<head>
    <title>WebRTC Server Stream Test</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #1a1a1a;
            color: white;
            padding: 20px;
        }

        #log {
            background: #000;
            border: 1px solid #444;
            height: 350px;
            overflow-y: scroll;
            padding: 10px;
            font-family: monospace;
            font-size: 12px;
            color: #00ff00;
            margin-top: 10px;
        }

        .error {
            color: #ff5555;
        }

        .success {
            color: #55ff55;
        }

        button {
            padding: 12px 24px;
            cursor: pointer;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            font-weight: bold;
        }

            button:disabled {
                background: #444;
            }

        audio {
            width: 100%;
            margin-top: 15px;
            border-radius: 4px;
            background: #333;
        }
    </style>
</head>
<body>
    <h1>🎵 Server Sine Wave Stream</h1>
    <button id="joinBtn">🚀 Start Listening</button>
    <div id="status" style="margin-top:10px;">Status: Idle</div>
    <audio id="remoteAudio" autoplay controls></audio>

    <div id="log"></div>

    <script src="~/microsoft-signalr/signalr.js" asp-append-version="true"></script>
    <script>
        const logDiv = document.getElementById("log");
        const statusDiv = document.getElementById("status");
        const remoteAudio = document.getElementById("remoteAudio");
        let pc = null;

        function logger(msg, type = 'info') {
            const entry = document.createElement("div");
            entry.className = type;
            entry.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
            logDiv.appendChild(entry);
            logDiv.scrollTop = logDiv.scrollHeight;
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/teststream")
            .withAutomaticReconnect()
            .build();

        function createPeerConnection(iceServers) {
            logger("🛠️ Initializing PeerConnection with TURN credentials...");

            // SANITIZATION: Ensure every object has the 'urls' property and valid credentials
            const sanitizedServers = (iceServers || [])
                .map(server => {
                    const s = {
                        urls: server.urls || server.Urls,
                        username: server.username || server.Username,
                        credential: server.credential || server.Credential
                    };

                    // Force credentialType to "password" if it's a TURN server
                    if (s.username && s.credential) {
                        s.credentialType = "password";
                    }
                    return s;
                })
                .filter(server => server.urls); // Only keep if it actually has a URL

            const config = {
                iceServers: sanitizedServers.length > 0
                    ? sanitizedServers
                    : [{ urls: "stun:stun.l.google.com:19302" }]
            };

            try {
                // Re-creating the connection instance
                pc = new RTCPeerConnection(config);

                pc.onconnectionstatechange = () => {
                    statusDiv.innerText = `Status: ${pc.connectionState}`;
                    logger(`WebRTC State Changed: ${pc.connectionState}`);
                    if (pc.connectionState === "failed") {
                        logger("❌ Connection failed. Check if TURN is working or if UDP is blocked.", "error");
                    }
                };

                pc.onicecandidate = (e) => {
                    if (e.candidate) {
                        connection.invoke("ReceiveIceCandidate", e.candidate.candidate)
                            .catch(err => logger("❌ Send ICE Error: " + err, "error"));
                    }
                };

                pc.ontrack = (event) => {
                    logger("🔊 SUCCESS: Track received from server!", 'success');
                    const track = event.track;
                    let stream = (event.streams && event.streams[0])
                                 ? event.streams[0]
                                 : new MediaStream([track]);

                    remoteAudio.srcObject = stream;
                    remoteAudio.play()
                        .then(() => logger("✅ Audio is playing", "success"))
                        .catch(err => logger("🔇 Audio play error: " + err.message, "error"));
                };
            } catch (err) {
                logger("❌ PC Constructor Error: " + err.message, "error");
                pc = null; // Ensure pc is null if creation fails
            }
        }

        connection.on("RtcOffer", async (data) => {
            try {
                logger("📥 Received Offer and ICE Servers from server");

                // 1. Initialize PC
                createPeerConnection(data.iceServers);

                if (!pc) {
                    throw new Error("PeerConnection could not be initialized.");
                }

                // 2. Set Remote Description
                await pc.setRemoteDescription(new RTCSessionDescription({ type: "offer", sdp: data.sdp }));

                // 3. Create and Set Local Answer
                logger("📝 Creating Answer...");
                const answer = await pc.createAnswer();
                await pc.setLocalDescription(answer);

                // 4. Send Answer back to Hub
                logger("📤 Sending Answer...");
                await connection.invoke("ReceiveAnswer", answer.sdp);
            } catch (err) {
                logger("❌ Negotiation Error: " + err.message, "error");
            }
        });

        connection.on("RtcIceCandidate", (data) => {
            if (data.candidate && pc) {
                pc.addIceCandidate(new RTCIceCandidate({ candidate: data.candidate }))
                    .catch(e => logger("❌ Add ICE Error: " + e.message, "error"));
            }
        });

        document.getElementById("joinBtn").onclick = async () => {
            try {
                document.getElementById("joinBtn").disabled = true;
                logger("🔌 Connecting to SignalR...");
                await connection.start();
                logger("✅ SignalR Connected. Requesting WebRTC Stream...");
                await connection.invoke("RequestOffer");
            } catch (err) {
                logger("❌ Connection Failed: " + err.message, "error");
                document.getElementById("joinBtn").disabled = false;
            }
        };
    </script>
</body>
</html>