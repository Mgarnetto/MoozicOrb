@{
    ViewData["Title"] = "MoozicOrb Hi-Fi";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MoozicOrb Hi-Fi</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <style>
        body {
            background-color: #000; /* Pure black for performance */
            color: #fff;
            font-family: monospace; /* Monospace is faster to render/load */
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        .player {
            background: #111;
            padding: 30px;
            border: 1px solid #333;
            text-align: center;
            width: 300px;
        }

        .status {
            color: #666;
            margin-bottom: 20px;
            font-size: 0.8rem;
            text-transform: uppercase;
        }

        /* HARDWARE ACCELERATED CANVAS */
        #visualizer {
            width: 100%;
            height: 80px;
            background: #000;
            margin-bottom: 20px;
            border-bottom: 1px solid #333;
            /* Force GPU acceleration */
            transform: translateZ(0);
        }

        .btn {
            background: #ff0055;
            color: white;
            border: none;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            font-size: 1.5rem;
            cursor: pointer;
        }

        .active {
            background: #00ff88;
            color: black;
        }

        .badge {
            background: #222;
            padding: 4px 8px;
            font-size: 0.7rem;
            color: #555;
            margin-top: 15px;
            display: inline-block;
        }
    </style>
</head>
<body>

    <div class="player">
        <div class="status" id="status">Ready</div>

        <canvas id="visualizer" width="300" height="80"></canvas>

        <button class="btn" id="playBtn">▶</button>
        <br />
        <div class="badge">PCM 44.1kHz</div>
    </div>

    <script>
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        // --- ULTRA LITE VISUALIZER ---
        const canvas = document.getElementById("visualizer");
        // Alpha: false tells browser "This canvas is never transparent", saving compositing time
        const canvasCtx = canvas.getContext("2d", { alpha: false });
        const analyser = audioCtx.createAnalyser();

        // FAST SETTINGS
        analyser.fftSize = 64; // 32 Bars (Lowest acceptable setting)
        analyser.smoothingTimeConstant = 0.3; // Very twitchy/reactive (0 = raw data, 1 = slow)
        analyser.connect(audioCtx.destination);

        const bufferLength = analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLength);
        let animationId;

        // Pre-calculate width to avoid division in the loop
        const barWidth = (canvas.width / bufferLength);

        // CONFIG
        const SAMPLE_RATE = 44100;
        const CHANNELS = 2;
        const BUFFER_DELAY = 0.5;

        let nextStartTime = 0;
        let isPlaying = false;
        let isBuffering = true;
        let activeSources = [];

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/teststream")
            .withAutomaticReconnect()
            .build();

        function decodePcm(buffer) {
            const numSamples = buffer.length / 2 / CHANNELS;
            const leftChannel = new Float32Array(numSamples);
            const rightChannel = new Float32Array(numSamples);
            let dataView = new DataView(buffer.buffer);

            for (let i = 0; i < numSamples; i++) {
                let offset = i * 2 * CHANNELS;
                let s1 = dataView.getInt16(offset, true);
                leftChannel[i] = s1 / 32768;
                let s2 = dataView.getInt16(offset + 2, true);
                rightChannel[i] = s2 / 32768;
            }
            return [leftChannel, rightChannel];
        }

        // --- THE FASTEST LOOP ---
        function drawVisualizer() {
            animationId = requestAnimationFrame(drawVisualizer);
            analyser.getByteFrequencyData(dataArray);

            // 1. Clear Screen (Solid Black)
            canvasCtx.fillStyle = '#000000';
            canvasCtx.fillRect(0, 0, canvas.width, canvas.height);

            // 2. Set Color ONCE (Neon Green)
            canvasCtx.fillStyle = '#00ff88';

            // 3. Batch Draw (Single Path)
            // This is the fastest way to draw multiple shapes in JS
            canvasCtx.beginPath();

            let x = 0;
            for (let i = 0; i < bufferLength; i++) {
                // Simple scaling
                const barHeight = dataArray[i] / 3;

                if (barHeight > 0) {
                    // Add rect to the path
                    canvasCtx.rect(x, canvas.height - barHeight, barWidth - 1, barHeight);
                }
                x += barWidth;
            }

            // 4. Paint the path to the GPU in one go
            canvasCtx.fill();
        };

        connection.on("ReceiveAudio", (base64Data) => {
            if (!isPlaying) return;

            const binaryString = window.atob(base64Data);
            const len = binaryString.length;
            const bytes = new Uint8Array(len);
            for (let i = 0; i < len; i++) { bytes[i] = binaryString.charCodeAt(i); }

            const [leftData, rightData] = decodePcm(bytes);

            const audioBuffer = audioCtx.createBuffer(CHANNELS, leftData.length, SAMPLE_RATE);
            audioBuffer.copyToChannel(leftData, 0);
            audioBuffer.copyToChannel(rightData, 1);

            const source = audioCtx.createBufferSource();
            source.buffer = audioBuffer;
            source.connect(analyser);
            activeSources.push(source);

            source.onended = () => {
                activeSources = activeSources.filter(s => s !== source);
            };

            const currentTime = audioCtx.currentTime;
            if (isBuffering) {
                nextStartTime = currentTime + BUFFER_DELAY;
                isBuffering = false;
            } else if (nextStartTime < currentTime) {
                nextStartTime = currentTime + 0.05;
            }

            source.start(nextStartTime);
            nextStartTime += audioBuffer.duration;
        });

        const playBtn = document.getElementById("playBtn");
        const statusEl = document.getElementById("status");

        playBtn.onclick = async () => {
            if (!isPlaying) {
                try {
                    await audioCtx.resume();
                    if (connection.state === signalR.HubConnectionState.Disconnected) {
                        statusEl.innerText = "Connecting...";
                        await connection.start();
                    }
                    isPlaying = true;
                    isBuffering = true;
                    playBtn.innerHTML = "■";
                    playBtn.classList.add("active");
                    statusEl.innerText = "ULTRA LITE";
                    statusEl.style.color = "#00ff88";

                    drawVisualizer();

                } catch (err) {
                    statusEl.innerText = "Error";
                    console.error(err);
                }
            } else {
                isPlaying = false;

                // Stop Everything
                activeSources.forEach(source => {
                    try { source.stop(); } catch(e) {}
                });
                activeSources = [];
                nextStartTime = 0;

                await connection.stop();

                playBtn.innerHTML = "▶";
                playBtn.classList.remove("active");
                statusEl.innerText = "Disconnected";
                statusEl.style.color = "#666";

                cancelAnimationFrame(animationId);
                canvasCtx.clearRect(0,0, canvas.width, canvas.height);
            }
        };
    </script>
</body>
</html>