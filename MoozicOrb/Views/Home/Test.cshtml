@{
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Infinite Music Artist Carousel</title>

    <!-- Bootstrap 5.1 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #111;
            color: #fff;
            padding: 40px;
            font-family: Arial, sans-serif;
        }

        .carousel-wrapper {
            width: 100%;
            overflow: hidden;
            border: 2px solid #444;
            border-radius: 10px;
            background: #000;
            padding: 10px 0;
        }

        .carousel-track {
            display: inline-flex;
            white-space: nowrap;
            animation: scroll 20s linear infinite;
        }

        .ad-card {
            display: inline-block;
            width: 250px;
            margin: 0 20px;
            background: #222;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            color: #fff;
            box-shadow: 0 0 10px rgba(255,255,255,0.1);
        }

            .ad-card img {
                width: 100%;
                border-radius: 10px;
                margin-bottom: 10px;
            }

        @@keyframes scroll {
            from

        {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }

        }
    </style>
</head>
<body>

    <h2 class="text-center mb-4">🎧 Featured Music Artists</h2>

    <div class="carousel-wrapper">
        <div class="carousel-track">

            <!-- ORIGINAL SET -->
            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/ff4444/ffffff?text=DJ+Thunder" alt="">
                <h5>DJ Thunder</h5>
                <p>New EDM album out now</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/44aaff/ffffff?text=Soul+Vibes" alt="">
                <h5>Soul Vibes</h5>
                <p>Live tour starts this summer</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/ffaa44/ffffff?text=Neon+Pulse" alt="">
                <h5>Neon Pulse</h5>
                <p>Electro-pop sensation</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/66dd66/ffffff?text=The+Echoes" alt="">
                <h5>The Echoes</h5>
                <p>New indie rock single</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/aa66ff/ffffff?text=R+Breeze" alt="">
                <h5>R Breeze</h5>
                <p>R&B chart‑topper</p>
            </div>

            <!-- DUPLICATE SET FOR SEAMLESS LOOP -->
            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/ff4444/ffffff?text=DJ+Thunder" alt="">
                <h5>DJ Thunder</h5>
                <p>New EDM album out now</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/44aaff/ffffff?text=Soul+Vibes" alt="">
                <h5>Soul Vibes</h5>
                <p>Live tour starts this summer</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/ffaa44/ffffff?text=Neon+Pulse" alt="">
                <h5>Neon Pulse</h5>
                <p>Electro-pop sensation</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/66dd66/ffffff?text=The+Echoes" alt="">
                <h5>The Echoes</h5>
                <p>New indie rock single</p>
            </div>

            <div class="ad-card">
                <img src="https://via.placeholder.com/250x150/aa66ff/ffffff?text=R+Breeze" alt="">
                <h5>R Breeze</h5>
                <p>R&B chart‑topper</p>
            </div>

        </div>
    </div>

    <!-- jQuery + Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>


