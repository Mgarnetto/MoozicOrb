    <button onclick="StreamService.startBroadcast()">Start Stream</button>
    <button onclick="StreamService.joinStream()">Join Stream</button>

    <audio id="audio-player" autoplay></audio>

    
    <br /><br />

    <h3 class="mb-4">Group Chat</h3>

    <div id="group-9" class="group-chat card mb-4" data-group-id="9">
        <div class="card-header bg-primary text-white">
            Group #9
        </div>

        <div class="card-body messages" style="height:300px; overflow-y:auto;">
            <!-- messages load here -->
        </div>

        <div class="card-footer d-flex gap-2">
            <input type="text" class="form-control group-text" placeholder="Type message...">
            <button class="btn btn-primary send-group" data-group-id="9">
                Send
            </button>
        </div>
    </div>
</div>



