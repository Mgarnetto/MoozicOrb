@{
    ViewData["Title"] = "Home Page";
}


<div class="container py-4">
    <div id="login-card" class="card mb-4">
        <div class="card-header">Login</div>
        <div class="card-body d-flex gap-2">
            <input type="text" id="login-username" class="form-control" placeholder="Username">
            <input type="password" id="login-password" class="form-control" placeholder="Password">
            <button class="btn btn-primary" id="login-button">Login</button>
            <button class="btn btn-secondary" id="logout-button">Logout</button>
        </div>
        <div id="login-status" class="mt-2 text-danger"></div>
    </div>


