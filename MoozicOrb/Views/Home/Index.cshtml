@{
    ViewData["Title"] = "Home Page";
}

@* <p>@ViewBag.Error</p> *@

<div class="container py-4">

    <!-- LOGIN CARD -->
    <div id="login-card" class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">
            Account Login
        </div>

        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md">
                    <input type="text"
                           id="login-username"
                           class="form-control"
                           placeholder="Username">
                </div>

                <div class="col-md">
                    <input type="password"
                           id="login-password"
                           class="form-control"
                           placeholder="Password">
                </div>

                <div class="col-md-auto d-flex gap-2">
                    <button class="btn btn-success"
                            id="login-button">
                        Login
                    </button>

                    <button class="btn btn-secondary"
                            id="logout-button">
                        Logout
                    </button>
                </div>
            </div>

            <div id="login-status"
                 class="mt-2 text-danger small">
            </div>
        </div>
    </div>

    <!-- STREAM PANEL -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <span class="fw-bold">Live Stream</span>
            <span id="stream-status"
                  class="badge bg-secondary">
                OFFLINE
            </span>
        </div>

        <div class="card-body">
            <div class="row g-3 align-items-center">

                <!-- STREAM CONTROLS -->
                <div class="col-md-auto d-flex gap-2 flex-wrap">
                    <button id="btn-start-broadcast"
                            class="btn btn-success auth-required">
                        🎙 Start Broadcast
                    </button>

                    <button id="btn-join-stream"
                            class="btn btn-primary auth-required">
                        🎧 Join Stream
                    </button>
                </div>

                <!-- STREAM MEDIA -->
                <div class="col d-flex gap-3 align-items-center justify-content-md-end flex-wrap">

                    <!-- LOCAL STREAM PREVIEW -->
                    <div class="d-flex flex-column align-items-center">
                        <small class="fw-bold text-muted">Preview</small>
                        <video id="stream-local-video"
                               autoplay
                               muted
                               playsinline
                               class="border rounded"
                               style="width:240px; height:180px; display:none;">
                        </video>
                    </div>

                    <!-- AUDIO PLAYER -->
                    <audio id="audio-player"
                           controls
                           autoplay
                           class="d-none">
                    </audio>
                </div>
            </div>
        </div>
    </div>

    <!-- CALL PANEL -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-warning text-dark fw-bold">
            Audio / Video Call (1 ↔ 1)
        </div>

        <div class="card-body">
            <div class="row g-4 align-items-start">

                <!-- VIDEO STRIP -->
                <div class="col-md-auto d-flex gap-3">

                    <div class="d-flex flex-column align-items-center">
                        <label class="fw-bold">Local</label>
                        <video id="local-video"
                               autoplay
                               muted
                               playsinline
                               class="border rounded"
                               style="width:200px; height:150px;">
                        </video>
                    </div>

                    <div class="d-flex flex-column align-items-center">
                        <label class="fw-bold">Remote</label>
                        <video id="remote-video"
                               autoplay
                               playsinline
                               class="border rounded"
                               style="width:200px; height:150px;">
                        </video>
                    </div>
                </div>

                <!-- CALL CONTROLS -->
                <div class="col">
                    <div id="call-status"
                         class="mb-2 text-muted">
                        Status: Idle
                    </div>

                    <select id="call-target-user"
                            class="form-select mb-3">
                        <option value="">-- Select Target User --</option>
                        <option value="2">User #2</option>
                        <option value="3">User #3</option>
                        <option value="4">User #4</option>
                    </select>

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-success auth-required"
                                onclick="
                                    const select = document.getElementById('call-target-user');
                                    const targetId = Number(select.value);
                                    if (!targetId) {
                                        alert('Please select a valid user');
                                        return;
                                    }
                                    startCall(targetId);
                                ">
                            Start Call
                        </button>

                        <button class="btn btn-danger auth-required"
                                onclick="hangupCall()">
                            Hang Up
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- GROUP CHAT -->
    <h3 class="mb-3">Group Chat</h3>

    <div id="group-9"
         class="group-chat card shadow-sm mb-4"
         data-group-id="9">

        <div class="card-header bg-primary text-white fw-bold">
            Group #9
        </div>

        <div class="card-body messages"
             style="height:300px; overflow-y:auto;">
        </div>

        <div class="card-footer d-flex gap-2">
            <input type="text"
                   class="form-control group-text"
                   placeholder="Type message...">

            <button class="btn btn-primary auth-required"
                    onclick="
                        const g = this.closest('.group-chat');
                        const id = Number(g.dataset.groupId);
                        const input = g.querySelector('.group-text');
                        sendGroupMessage(id, input.value);
                        input.value = '';
                    ">
                Send
            </button>
        </div>
    </div>

</div>













