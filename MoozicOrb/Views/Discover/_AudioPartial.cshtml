<div class="container-fluid pt-4 fade-in" style="max-width: 1000px; margin: 0 auto;">

    <div class="audio-header-card">
        <div class="position-relative z-1">
            <h2 class="text-white fw-bold mb-1" style="font-family: 'Outfit', sans-serif;">
                <i class="fas fa-headphones-alt me-2 text-info"></i> Audio Discovery
            </h2>
            <p class="text-muted mb-0 mt-2" style="font-size: 1rem;">
                Fresh frequencies and underground sounds from around the Orb.
            </p>
        </div>
        <div class="audio-header-glow"></div>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-4 px-2">
        <div class="text-info small fw-bold text-uppercase" style="letter-spacing: 1px;">
            <i class="fas fa-signal me-2"></i> Live Feed
        </div>

        <button class="btn btn-sm btn-outline-info rounded-pill px-4 fw-bold" onclick="loadAudioPlaylist()">
            <i class="fas fa-sync-alt me-2"></i> REFRESH LIST
        </button>
    </div>

    <div id="audio-feed-list" class="pb-5">
    </div>

</div>

<script>
    // Ensure the playlist loads immediately when this view is rendered via Router
    if (window.loadAudioPlaylist) {
        window.loadAudioPlaylist();
    }
</script>