@model MoozicOrb.Models.SearchViewModel

<div class="container-fluid pt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <div>
            <h2 class="text-info fw-light">
                <i class="fas fa-compact-disc me-2"></i>Audio Discovery
            </h2>
            <p class="text-muted small mb-0">Searching tracks: <span class="text-white">"@Model.Query"</span></p>
        </div>
    </div>

    @if (Model.Posts == null || Model.Posts.Count == 0)
    {
        <div class="text-center py-5">
            <div class="mb-3 text-muted" style="opacity: 0.2;">
                <i class="fas fa-music fa-5x"></i>
            </div>
            <h4 class="text-white">No tracks found</h4>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var post in Model.Posts)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="track-card bg-dark border-secondary h-100 hover-elevate">
                        <button class="btn-track-play me-3">
                            <i class="fas fa-play"></i>
                        </button>

                        <div class="flex-shrink-0 me-3">
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl" width="50" height="50" class="rounded" style="object-fit: cover;">
                            }
                            else
                            {
                                <div class="rounded bg-secondary d-flex align-items-center justify-content-center" style="width:50px; height:50px;">
                                    <i class="fas fa-music text-dark"></i>
                                </div>
                            }
                        </div>

                        <div class="track-info overflow-hidden">
                            <div class="track-title text-truncate">
                                <a href="/post/@post.Id" class="text-white text-decoration-none">
                                    @(string.IsNullOrEmpty(post.Title) ? "Untitled Track" : post.Title)
                                </a>
                            </div>
                            <div class="track-artist text-truncate">
                                by @post.AuthorName
                            </div>
                        </div>

                        @if (post.Attachments != null && post.Attachments.Any(m => m.MediaType == 1))
                        {
                            var audio = post.Attachments.First(m => m.MediaType == 1);
                            <audio class="d-none" data-track-src="@audio.Url"></audio>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>